# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate each secret with: openssl rand -base64 48

# DNS names pointing at this server (Caddy gets HTTPS certificates for both).
API_DOMAIN=api.example.com
PUSH_DOMAIN=push.example.com

POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
OTP_HASH_PEPPER=
SEARXNG_SECRET=

# WebAuthn / passkeys — must match the real domain or passkeys fail.
RP_NAME=HERE
RP_ID=api.example.com
ORIGIN=https://api.example.com

# Phone OTP (MSG91) — required, or sign-in texts aren't sent.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=

# Google Sign-In (server client ID) and Apple Sign-In.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Ask HERE AI answers. Ollama isn't in this stack: point this at a machine
# with a GPU that runs it (a small CPU-only server is too slow).
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5-local
OLLAMA_EMBED_MODEL=nomic-embed-text

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
STACKEXCHANGE_KEY=
