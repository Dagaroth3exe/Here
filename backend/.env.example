NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://here:here@localhost:5432/here

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
TOTP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# WebAuthn / passkeys
RP_NAME=HERE
RP_ID=localhost
ORIGIN=http://localhost:3000

# Phone OTP (MSG91)
OTP_HASH_PEPPER=change-me-to-a-long-random-string
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=

# Google Sign-In
GOOGLE_CLIENT_ID=

# Apple Sign-In
APPLE_CLIENT_ID=

# Ask HERE AI answers — self-hosted SearXNG (docker-compose) + Ollama
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=change-me-to-a-long-random-string
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-local
# Ranks passages of fetched pages by relevance (ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Community replies for Ask HERE. Reddit blocks logged-out access, so create a
# "script" app at https://www.reddit.com/prefs/apps (free for non-commercial
# use) and paste its id/secret. Without them only Stack Exchange is read.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for "<platform>:<app id>:<version> (by /u/<your username>)"
REDDIT_USER_AGENT=
# Optional: raises Stack Exchange's anonymous limit (300/day) to 10,000/day.
STACKEXCHANGE_KEY=

# Push notifications (UnifiedPush via the self-hosted ntfy in docker-compose).
# PUBLIC is the address phones use for ntfy (10.0.2.2 = this machine, from the
# Android emulator; use a LAN/public URL for real phones). INTERNAL is how the
# backend reaches the same server. Only endpoints under PUBLIC are accepted.
NTFY_PUBLIC_URL=http://10.0.2.2:8090
NTFY_INTERNAL_URL=http://localhost:8090
